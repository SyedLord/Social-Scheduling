# GEMINI_API_KEY: Required for optional Gemini AI caption generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Optional: Production OAuth 2.0 Credentials for Live Social Media Platforms
# If not configured, OmniPost runs in high-fidelity sandbox mode with instant channel linking & verification.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

META_APP_ID=""
META_APP_SECRET=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# Supabase backend (server-only)
# Server-only Supabase secret key. Prefer the modern sb_secret_... key.
# Legacy SUPABASE_SERVICE_ROLE_KEY is supported for compatibility.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
